
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Multimedia Example</title>
</head>
<body>

    <h2>Multimedia Elements</h2>

    <h3>1. Image</h3>
    <img src="https://dummyimage.com/180x140/ddeeff/223344.png&text=College+Campus"
         alt="College Campus" width="180" height="140">

    <h3>2. Video</h3>
    <video width="320" controls>
        <source src="sample-video.mp4" type="video/mp4">
        Your browser does not support video.
    </video>

    <h3>3. Audio</h3>
    <audio controls>
        <source src="sample-audio.mp3" type="audio/mpeg">
        Your browser does not support audio.
    </audio>

    <h3>4. YouTube Video</h3>
    <iframe width="320" height="180"
        src="https://www.youtube-nocookie.com/embed/M7lc1UVf-VE"
        title="YouTube video player"
        allowfullscreen>
    </iframe>

</body>
</html>
