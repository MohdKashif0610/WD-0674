
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Quotation and Citation</title>
</head>
<body>

    <h2>Quotation and Citation Elements</h2>

    <!-- Blockquote -->
    <h3>Blockquote</h3>
    <blockquote>
        The best way to predict the future is to create it.
    </blockquote>

    <!-- Inline Quotation -->
    <h3>Inline Quotation</h3>
    <p>
        As he said, <q>Stay hungry, stay foolish.</q>
    </p>

    <!-- Citation -->
    <h3>Citation</h3>
    <p>
        Book: <cite>The Pragmatic Programmer</cite>
    </p>

    <!-- Abbreviation -->
    <h3>Abbreviation</h3>
    <p>
        <abbr title="World Wide Web Consortium">W3C</abbr>
        sets web standards.
    </p>

    <!-- Address -->
    <h3>Contact Address</h3>
    <address>
        Contact: Admin Office<br>
        College Road, Delhi
    </address>

    <!-- Deleted and Inserted Text -->
    <h3>Text Modification</h3>
    <p>
        <del>Old price 500</del>
        <ins>New price 400</ins>
    </p>

</body>
</html>
